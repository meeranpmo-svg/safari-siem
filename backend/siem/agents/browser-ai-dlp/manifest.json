{
  "manifest_version": 3,
  "name": "Zyberon AI DLP",
  "version": "1.0.0",
  "description": "Checks what you give AI apps for personal, financial, health and confidential data, on this computer, under the organisation policy.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "identity",
    "identity.email"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://api.openai.com/*",
        "https://*.api.openai.com/*",
        "https://platform.openai.com/*",
        "https://*.platform.openai.com/*",
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://*.chat.openai.com/*",
        "https://oaistatic.com/*",
        "https://*.oaistatic.com/*",
        "https://oaiusercontent.com/*",
        "https://*.oaiusercontent.com/*",
        "https://api.anthropic.com/*",
        "https://*.api.anthropic.com/*",
        "https://console.anthropic.com/*",
        "https://*.console.anthropic.com/*",
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://claudeusercontent.com/*",
        "https://*.claudeusercontent.com/*",
        "https://generativelanguage.googleapis.com/*",
        "https://*.generativelanguage.googleapis.com/*",
        "https://gemini.google.com/*",
        "https://*.gemini.google.com/*",
        "https://bard.google.com/*",
        "https://*.bard.google.com/*",
        "https://aistudio.google.com/*",
        "https://*.aistudio.google.com/*",
        "https://notebooklm.google.com/*",
        "https://*.notebooklm.google.com/*",
        "https://githubcopilot.com/*",
        "https://*.githubcopilot.com/*",
        "https://copilot-proxy.githubusercontent.com/*",
        "https://*.copilot-proxy.githubusercontent.com/*",
        "https://copilot.microsoft.com/*",
        "https://*.copilot.microsoft.com/*",
        "https://copilot.cloud.microsoft/*",
        "https://*.copilot.cloud.microsoft/*",
        "https://sydney.bing.com/*",
        "https://*.sydney.bing.com/*",
        "https://perplexity.ai/*",
        "https://*.perplexity.ai/*",
        "https://deepseek.com/*",
        "https://*.deepseek.com/*",
        "https://mistral.ai/*",
        "https://*.mistral.ai/*",
        "https://meta.ai/*",
        "https://*.meta.ai/*",
        "https://grok.com/*",
        "https://*.grok.com/*",
        "https://x.ai/*",
        "https://*.x.ai/*",
        "https://poe.com/*",
        "https://*.poe.com/*",
        "https://character.ai/*",
        "https://*.character.ai/*",
        "https://chat.qwen.ai/*",
        "https://*.chat.qwen.ai/*",
        "https://qianwen.aliyun.com/*",
        "https://*.qianwen.aliyun.com/*",
        "https://tongyi.aliyun.com/*",
        "https://*.tongyi.aliyun.com/*",
        "https://kimi.com/*",
        "https://*.kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://*.kimi.moonshot.cn/*",
        "https://huggingface.co/*",
        "https://*.huggingface.co/*",
        "https://hf.co/*",
        "https://*.hf.co/*",
        "https://midjourney.com/*",
        "https://*.midjourney.com/*",
        "https://otter.ai/*",
        "https://*.otter.ai/*",
        "https://fireflies.ai/*",
        "https://*.fireflies.ai/*",
        "https://grammarly.com/*",
        "https://*.grammarly.com/*",
        "https://grammarly.io/*",
        "https://*.grammarly.io/*",
        "https://deepl.com/*",
        "https://*.deepl.com/*",
        "https://quillbot.com/*",
        "https://*.quillbot.com/*",
        "https://cursor.com/*",
        "https://*.cursor.com/*",
        "https://cursor.sh/*",
        "https://*.cursor.sh/*",
        "https://windsurf.com/*",
        "https://*.windsurf.com/*",
        "https://codeium.com/*",
        "https://*.codeium.com/*",
        "https://jasper.ai/*",
        "https://*.jasper.ai/*",
        "https://gamma.app/*",
        "https://*.gamma.app/*"
      ],
      "js": [
        "classify.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "storage": {
    "managed_schema": "managed_schema.json"
  }
}
