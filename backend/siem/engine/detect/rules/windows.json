  {"id":"SENTRA-SYS-003","name":"Service installed with a suspicious binary path","enabled":true,"severity":4,"mitre":["T1543.003","T1569.002"],"sama":["3.3.7","3.3.8"],"tactic":"execution","author":"Sentra SOC","version":1,"description":"Service image path uses a shell, script host, LOLBin, admin share or user-writable folder (PsExec-style lateral movement, malware).","type":"single","match":{"all":[{"field":"event_code","op":"in","value":["7045","4697"]},{"any":[{"field":"cmdline","op":"re","value":"cmd(\\.exe)?\\s*/[ck]|powershell|pwsh|mshta|rundll32|regsvr32|wscript|cscript|%comspec%|\\\\(temp|tmp|appdata|users\\\\public|programdata)\\\\|\\\\\\\\[^\\\\]+\\\\(admin|c)\\$"},{"field":"fields.ImagePath","op":"re","value":"cmd(\\.exe)?\\s*/[ck]|powershell|pwsh|mshta|rundll32|regsvr32|wscript|cscript|%comspec%|\\\\(temp|tmp|appdata|users\\\\public|programdata)\\\\|\\\\\\\\[^\\\\]+\\\\(admin|c)\\$"},{"field":"fields.ServiceFileName","op":"re","value":"cmd(\\.exe)?\\s*/[ck]|powershell|pwsh|mshta|rundll32|regsvr32|wscript|cscript|%comspec%|\\\\(temp|tmp|appdata|users\\\\public|programdata)\\\\|\\\\\\\\[^\\\\]+\\\\(admin|c)\\$"}]}]},"group_by":["host","fields.service_name","fields.ServiceName"],"suppress_s":3600,"fields_in_alert":["host","user","fields.service_name","cmdline","fields.ImagePath","fields.ServiceFileName"]},
  {"id":"SENTRA-SYS-004","name":"Scheduled task created","enabled":true,"severity":2,"mitre":["T1053.005"],"sama":["3.3.7","3.3.8"],"tactic":"persistence","author":"Sentra SOC","version":1,"description":"Windows 4698 (scheduled task created) or schtasks /create on a process command line.","type":"single","match":{"any":[{"field":"action","op":"eq","value":"scheduled-task-created"},{"field":"event_code","op":"eq","value":"4698"},{"field":"cmdline","op":"re","value":"schtasks(\\.exe)?\"?\\s+.*[/-]create"}]},"group_by":["host","fields.task_name","fields.TaskName"],"suppress_s":3600,"fields_in_alert":["host","user","fields.task_name","cmdline"]},
  {"id":"SENTRA-EXEC-001","name":"PowerShell encoded command","enabled":true,"severity":3,"mitre":["T1059.001","T1027"],"sama":["3.3.8"],"tactic":"execution","author":"Sentra SOC","version":1,"description":"powershell/pwsh started with -e/-enc/-EncodedCommand and a base64 payload (4688 / Sysmon 1).","type":"single","match":{"all":[{"field":"cmdline","op":"re","value":"(powershell|pwsh)(\\.exe)?\"?\\s.*[-/–—]e(c|n(c(o(d(e(d(c(o(m(m(a(n(d)?)?)?)?)?)?)?)?)?)?)?)?)?\\s+['\"]?[a-z0-9+/]{20,}"}]},"group_by":["host","user"],"suppress_s":3600,"fields_in_alert":["host","user","process","parent_process","cmdline"]},
  {"id":"SENTRA-EXEC-002","name":"PowerShell download cradle","enabled":true,"severity":3,"mitre":["T1059.001","T1105"],"sama":["3.3.8"],"tactic":"command-and-control","author":"Sentra SOC","version":1,"description":"Command line or PowerShell script block (4104; the core parser puts script text in cmdline) downloads content: Net.WebClient, DownloadString/File, Invoke-WebRequest, BITS, certutil -urlcache.","type":"single","match":{"any":[{"field":"cmdline","op":"re","value":"net\\.webclient|download(string|file|data)\\s*\\(|invoke-webrequest|\\biwr\\s+['\"]?https?:|invoke-restmethod|\\birm\\s+['\"]?https?:|start-bitstransfer|bitsadmin(\\.exe)?\\s.*/transfer|certutil(\\.exe)?\\s.*-urlcache|net\\.http\\.httpclient|msxml2\\.xmlhttp"},{"field":"fields.ScriptBlockText","op":"re","value":"net\\.webclient|download(string|file|data)\\s*\\(|invoke-webrequest|\\biwr\\s+['\"]?https?:|invoke-restmethod|\\birm\\s+['\"]?https?:|start-bitstransfer|net\\.http\\.httpclient|msxml2\\.xmlhttp"}]},"group_by":["host","user"],"suppress_s":3600,"fields_in_alert":["host","user","process","parent_process","cmdline"]},
  {"id":"SENTRA-EXEC-003","name":"AMSI bypass attempt","enabled":true,"severity":4,"mitre":["T1685"],"sama":["3.3.8"],"tactic":"defense-impairment","author":"Sentra SOC","version":1,"description":"AMSI tampering strings (AmsiUtils, amsiInitFailed, AmsiScanBuffer patching) in a script block or command line.","type":"single","match":{"any":[{"field":"fields.ScriptBlockText","op":"re","value":"amsiutils|amsiinitfailed|amsiscanbuffer|amsicontext|amsiopensession|management\\.automation\\.amsi"},{"field":"cmdline","op":"re","value":"amsiutils|amsiinitfailed|amsiscanbuffer|amsicontext|amsiopensession|management\\.automation\\.amsi"}]},"group_by":["host","user"],"suppress_s":3600,"fields_in_alert":["host","user","process","cmdline"]},
  {"id":"SENTRA-CRED-001","name":"LSASS memory dump attempt","enabled":true,"severity":4,"mitre":["T1003.001"],"sama":["3.3.5","3.3.8"],"tactic":"credential-access","author":"Sentra SOC","version":1,"description":"Command line dumps LSASS: procdump lsass, comsvcs.dll MiniDump, Out-Minidump, createdump, nanodump, lsass.dmp.","type":"single","match":{"any":[{"field":"cmdline","op":"re","value":"procdump(64)?(\\.exe)?\\s.*lsass|comsvcs(\\.dll)?[\\s,]+#?(minidump|24)\\b|out-minidump|createdump(\\.exe)?\\s.*lsass|nanodump|lsass(\\.exe)?\\.(dmp|zip)|\\blsass\\.dmp|sqldumper(\\.exe)?\\s.*0x0110"},{"field":"fields.ScriptBlockText","op":"re","value":"comsvcs(\\.dll)?[\\s,]+#?(minidump|24)\\b|out-minidump|minidumpwritedump.*lsass"}]},"group_by":["host","user"],"suppress_s":3600,"fields_in_alert":["host","user","process","parent_process","cmdline"]},
  {"id":"SENTRA-CRED-002","name":"Mimikatz / credential theft tool indicators","enabled":true,"severity":4,"mitre":["T1003","T1558"],"sama":["3.3.5","3.3.8"],"tactic":"credential-access","author":"Sentra SOC","version":1,"description":"Mimikatz module syntax (sekurlsa::, lsadump::, kerberos::golden …), Invoke-Mimikatz or a mimikatz binary.","type":"single","match":{"any":[{"field":"cmdline","op":"re","value":"sekurlsa::|lsadump::|kerberos::(golden|ptt|list)|privilege::debug|crypto::capi|dpapi::|token::elevate|invoke-mimikatz|\\bmimikatz\\b|pypykatz"},{"field":"fields.ScriptBlockText","op":"re","value":"sekurlsa::|lsadump::|kerberos::(golden|ptt)|invoke-mimikatz|\\bmimikatz\\b"},{"field":"process","op":"re","value":"(^|\\\\|/)mimikatz(\\.exe)?$"}]},"group_by":["host","user"],"suppress_s":3600,"fields_in_alert":["host","user","process","cmdline"]},
  {"id":"SENTRA-CRED-003","name":"Suspicious access to LSASS process memory","enabled":true,"severity":3,"mitre":["T1003.001"],"sama":["3.3.5","3.3.8"],"tactic":"credential-access","author":"Sentra SOC","version":1,"description":"Sysmon 10: a non-system process opened lsass.exe with memory-read access rights.","type":"single","match":{"all":[{"field":"event_code","op":"eq","value":"10"},{"field":"fields.TargetImage","op":"endswith","value":"\\lsass.exe"},{"field":"fields.GrantedAccess","op":"in","value":["0x1010","0x1410","0x1438","0x143a","0x1418","0x1f0fff","0x1f1fff","0x1f2fff","0x1f3fff","0x1fffff","0x40"]}],"none":[{"field":"process","op":"re","value":"\\\\(msmpeng|mssense|csrss|wininit|wmiprvse|lsm|svchost|vmtoolsd|taskmgr|procexp64|procexp|mrt|sense[a-z]*)\\.exe$"},{"field":"fields.SourceImage","op":"re","value":"\\\\(msmpeng|mssense|csrss|wininit|wmiprvse|lsm|svchost|vmtoolsd|taskmgr|procexp64|procexp|mrt|sense[a-z]*)\\.exe$"}]},"group_by":["host","process","fields.SourceImage"],"suppress_s":3600,"fields_in_alert":["host","user","process","fields.SourceImage","fields.TargetImage","fields.GrantedAccess"]},
  {"id":"SENTRA-CRED-004","name":"Kerberos service ticket with RC4 encryption","enabled":true,"severity":2,"mitre":["T1558.003"],"sama":["3.3.5","3.3.8"],"tactic":"credential-access","author":"Sentra SOC","version":1,"description":"4769 with RC4/DES-CBC-MD5 ticket encryption (0x17/0x18) for a user service account — possible Kerberoasting.","type":"single","match":{"all":[{"field":"event_code","op":"eq","value":"4769"},{"any":[{"field":"fields.ticket_encryption","op":"in","value":["0x17","0x18","23","24"]},{"field":"fields.TicketEncryptionType","op":"in","value":["0x17","0x18","23","24"]}]}],"none":[{"field":"fields.service_name","op":"endswith","value":"$"},{"field":"fields.ServiceName","op":"endswith","value":"$"},{"field":"fields.service_name","op":"eq","value":"krbtgt"},{"field":"fields.ServiceName","op":"eq","value":"krbtgt"},{"field":"outcome","op":"eq","value":"failure"},{"all":[{"field":"fields.Status","op":"exists","value":true},{"field":"fields.Status","op":"neq","value":"0x0"}]}]},"group_by":["user","fields.service_name","fields.ServiceName"],"suppress_s":86400,"fields_in_alert":["user","src_ip","fields.service_name","fields.ticket_encryption","host"]},
  {"id":"SENTRA-CRED-005","name":"Kerberoasting — RC4 tickets for many SPNs","enabled":true,"severity":4,"mitre":["T1558.003"],"sama":["3.3.5","3.3.8"],"tactic":"credential-access","author":"Sentra SOC","version":1,"description":"One account requests RC4 service tickets for 5 or more different services within 10 minutes.","type":"distinct","match":{"all":[{"field":"event_code","op":"eq","value":"4769"},{"any":[{"field":"fields.ticket_encryption","op":"in","value":["0x17","0x18","23","24"]},{"field":"fields.TicketEncryptionType","op":"in","value":["0x17","0x18","23","24"]}]}],"none":[{"field":"fields.service_name","op":"endswith","value":"$"},{"field":"fields.ServiceName","op":"endswith","value":"$"},{"field":"fields.service_name","op":"eq","value":"krbtgt"},{"field":"fields.ServiceName","op":"eq","value":"krbtgt"},{"field":"outcome","op":"eq","value":"failure"},{"all":[{"field":"fields.Status","op":"exists","value":true},{"field":"fields.Status","op":"neq","value":"0x0"}]}]},"group_by":["user"],"distinct_field":"fields.service_name","distinct_count":5,"window_s":600,"suppress_s":3600,"fields_in_alert":["user","src_ip","host"]},
  {"id":"SENTRA-CRED-006","name":"AS-REP roasting (Kerberos pre-auth not required)","enabled":true,"severity":3,"mitre":["T1558.004"],"sama":["3.3.5","3.3.8"],"tactic":"credential-access","author":"Sentra SOC","version":1,"description":"4768 TGT issued without Kerberos pre-authentication (PreAuthType 0) — AS-REP roastable account used.","type":"single","match":{"all":[{"field":"event_code","op":"eq","value":"4768"},{"any":[{"field":"fields.preauth_type","op":"in","value":["0","0x0"]},{"field":"fields.PreAuthType","op":"in","value":["0","0x0"]}]}],"none":[{"field":"outcome","op":"eq","value":"failure"},{"all":[{"field":"fields.Status","op":"exists","value":true},{"field":"fields.Status","op":"neq","value":"0x0"}]},{"field":"user","op":"endswith","value":"$"}]},"group_by":["user","src_ip"],"suppress_s":3600,"fields_in_alert":["user","src_ip","fields.ticket_encryption","host"]}
