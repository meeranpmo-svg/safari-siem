[
  {"id":"SENTRA-IAM-001","name":"Member added to a privileged group","enabled":true,"severity":4,"mitre":["T1098","T1078.002"],"sama":["3.3.5","3.3.7"],"tactic":"persistence","author":"Sentra SOC","version":1,"description":"Windows 4728/4732/4756 adding a member to Domain/Enterprise/Schema Admins, Administrators or an Operators group.","type":"single","match":{"all":[{"field":"event_code","op":"in","value":["4728","4732","4756"]}],"any":[{"field":"fields.group","op":"re","value":"(domain|enterprise|schema|key|enterprise key) admins|^administrators$|\\\\administrators$|(account|backup|server|print) operators|dnsadmins|group policy creator owners"},{"field":"fields.TargetUserName","op":"re","value":"(domain|enterprise|schema|key|enterprise key) admins|^administrators$|\\\\administrators$|(account|backup|server|print) operators|dnsadmins|group policy creator owners"},{"field":"fields.GroupName","op":"re","value":"(domain|enterprise|schema|key|enterprise key) admins|^administrators$|\\\\administrators$|(account|backup|server|print) operators|dnsadmins|group policy creator owners"},{"field":"fields.TargetSid","op":"re","value":"-(512|518|519|526|527|544|548|549|550|551)$"}]},"group_by":["target_user","fields.group"],"suppress_s":3600,"fields_in_alert":["user","target_user","fields.group","host"]},
