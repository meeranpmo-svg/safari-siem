  {"id":"SENTRA-EXO-011","name":"Burst of external mail sent from one mailbox","enabled":true,"severity":3,"mitre":["T1048.003","T1114"],"sama":["3.3.14"],"tactic":"exfiltration","author":"Sentra SOC","version":1,"description":"Message tracking: 100 or more SEND events (mail leaving the Exchange organisation over SMTP) from one sender within 10 minutes; hybrid Office 365 connectors excluded.","type":"threshold","match":{"all":[{"field":"action","op":"eq","value":"send"},{"field":"category","op":"eq","value":"email"},{"field":"src_type","op":"eq","value":"exchange"},{"field":"user","op":"exists","value":true}],"none":[{"field":"fields.connector_id","op":"re","value":"office ?365|exchange ?online|hybrid|intra-?org"},{"field":"user","op":"re","value":"^(microsoftexchange|postmaster|<>$)"}]},"group_by":["user"],"window_s":600,"count":100,"suppress_s":3600,"fields_in_alert":["user","host","src_ip","fields.connector_id","fields.recipient_count"]},
  {"id":"SENTRA-EXO-012","name":"Exchange exploitation pattern in IIS log (ProxyLogon / ProxyShell / ProxyNotShell)","enabled":true,"severity":4,"mitre":["T1190"],"sama":["3.3.8","3.3.17"],"tactic":"initial-access","author":"Sentra SOC","version":1,"description":"autodiscover.json SSRF towards /mapi/, /powershell, /ews or X-Rps-CAT; ProxyLogon ECP artefacts (/ecp/<x>.js, default.flt, DDIService SetObject) or .aspx under OWA theme resources.","type":"single","match":{"all":[{"field":"category","op":"eq","value":"web"},{"any":[{"field":"tags","op":"eq","value":"proxyshell"},{"field":"url","op":"re","value":"autodiscover\\.json(\\?|%3f)[^ ]*(@|%40)[^ ]*(/mapi/|/powershell|/ews/|/owa/|protocol=xrps|x-rps-cat)|x-rps-cat=|^/ecp/[a-z0-9]{1,3}\\.js(\\?|$)|^/ecp/default\\.flt|/ecp/ddi/ddiservice\\.svc/setobject|/ecp/proxylogon\\.ecp|/owa/auth/current/themes/resources/[^?]*\\.aspx"}]}]},"group_by":["src_ip","host"],"suppress_s":3600,"fields_in_alert":["src_ip","host","url","http_status","user_agent"]},
  {"id":"SENTRA-EXO-013","name":"Unauthenticated /ecp/ request spike from one source","enabled":true,"severity":3,"mitre":["T1190","T1595.002"],"sama":["3.3.8","3.3.17"],"tactic":"reconnaissance","author":"Sentra SOC","version":1,"description":"100 or more unauthenticated (no cs-username) requests to the Exchange Control Panel (/ecp/) from one client IP within 5 minutes.","type":"threshold","match":{"all":[{"field":"category","op":"eq","value":"web"},{"field":"url","op":"startswith","value":"/ecp/"}],"none":[{"field":"user","op":"exists","value":true},{"field":"src_ip","op":"cidr","value":["127.0.0.0/8","::1/128"]}]},"group_by":["src_ip"],"window_s":300,"count":100,"suppress_s":3600,"fields_in_alert":["src_ip","host","url","user_agent"]},
  {"id":"SENTRA-EXO-014","name":"Web shell-like .aspx request under OWA/ECP directories","enabled":true,"severity":4,"mitre":["T1505.003"],"sama":["3.3.8","3.3.17"],"tactic":"persistence","author":"Sentra SOC","version":1,"description":"Successful request for an .aspx page under /aspnet_client/, /owa/auth/ or /ecp/auth/ that is not a stock Exchange page (typical Exchange web shell locations).","type":"single","match":{"all":[{"field":"category","op":"eq","value":"web"},{"field":"url","op":"re","value":"^/(aspnet_client|owa/auth|ecp/auth)/[^?]*\\.aspx"},{"field":"http_status","op":"lt","value":400}],"none":[{"field":"url","op":"re","value":"^/(owa/auth/(logon|logoff|errorfe|expiredpassword|frowny|signout|timeoutlogout|redirsuite|onetimepassword|changepassword|outlookredirect)\\.aspx|ecp/auth/(logon|logoff|timeoutlogout)\\.aspx)(\\?|$)"}]},"group_by":["src_ip","host","url"],"suppress_s":3600,"fields_in_alert":["src_ip","host","url","http_method","http_status","user_agent"]},
  {"id":"SENTRA-EXO-015","name":"Exchange remote PowerShell from a new source host","enabled":true,"severity":3,"mitre":["T1059.001","T1021.006"],"sama":["3.3.5"],"tactic":"execution","author":"Sentra SOC","version":1,"description":"Request to the Exchange /powershell endpoint from a client IP not seen for that server during the 7-day learning baseline (loopback excluded).","type":"new_value","match":{"all":[{"field":"category","op":"eq","value":"web"},{"field":"url","op":"re","value":"^/powershell(/|\\?|$)"}],"none":[{"field":"src_ip","op":"cidr","value":["127.0.0.0/8","::1/128"]}]},"group_by":["host"],"new_field":"src_ip","learn_s":604800,"window_s":86400,"suppress_s":3600,"fields_in_alert":["src_ip","host","user","user_agent"]},
