[
  {"id":"SENTRA-EXO-001","name":"Inbox rule that forwards, redirects, deletes or hides mail","enabled":true,"severity":3,"mitre":["T1114.003","T1564.008"],"sama":["3.3.14","3.4.3"],"tactic":"collection","author":"Sentra SOC","version":1,"description":"New/Set-InboxRule or UpdateInboxRules (Exchange Online or on-prem) with ForwardTo/RedirectTo/ForwardAsAttachmentTo, DeleteMessage, MarkAsRead or MoveToFolder.","type":"single","match":{"all":[{"any":[{"field":"action","op":"in","value":["inbox-rule-created","inbox-rule-modified"]},{"field":"fields.exchange_action","op":"in","value":["inbox-rule-created","inbox-rule-modified"]},{"all":[{"all":[{"field":"fields.exchange_action","op":"exists","value":false}]},{"any":[{"field":"event_code","op":"in","value":["New-InboxRule","Set-InboxRule","UpdateInboxRules"]},{"field":"fields.cmdlet","op":"in","value":["New-InboxRule","Set-InboxRule","UpdateInboxRules"]}]}]}]},{"any":[{"field":"tags","op":"in","value":["T1114.003","T1564.008"]},{"all":[{"all":[{"field":"fields.exchange_action","op":"exists","value":false}]},{"field":"fields.Parameters","op":"re","value":"forwardto|forwardasattachmentto|redirectto|deletemessage|softdeletemessage|markasread|movetofolder"}]}]}]},"group_by":["user","target_user"],"suppress_s":3600,"fields_in_alert":["user","target_user","src_ip","fields.cmdlet","fields.Parameters","host"]},
