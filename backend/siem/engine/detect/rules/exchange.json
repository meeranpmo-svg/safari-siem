  {"id":"SENTRA-EXO-009","name":"Mass MailItemsAccessed by one account","enabled":true,"severity":3,"mitre":["T1114.002"],"sama":["3.3.5","3.3.14"],"tactic":"collection","author":"Sentra SOC","version":1,"description":"One account generates 200 or more MailItemsAccessed audit records within 1 hour (bulk mailbox read or sync by an attacker or rogue app).","type":"threshold","match":{"all":[{"any":[{"field":"action","op":"in","value":["mail-items-accessed"]},{"field":"fields.exchange_action","op":"in","value":["mail-items-accessed"]},{"all":[{"all":[{"field":"fields.exchange_action","op":"exists","value":false}]},{"any":[{"field":"event_code","op":"in","value":["MailItemsAccessed"]},{"field":"fields.cmdlet","op":"in","value":["MailItemsAccessed"]}]}]}]}]},"group_by":["user"],"window_s":3600,"count":200,"suppress_s":3600,"fields_in_alert":["user","src_ip","target_user","fields.client_info","fields.mail_access_type"]},
