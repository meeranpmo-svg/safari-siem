  {"id":"SENTRA-LNX-001","name":"SSH brute force from one source","enabled":true,"severity":3,"mitre":["T1110.001","T1021.004"],"sama":["3.3.5","3.3.14"],"tactic":"credential-access","author":"Sentra SOC","version":1,"description":"20 or more failed SSH logons from the same source IP within 5 minutes.","type":"threshold","match":{"all":[{"field":"action","op":"eq","value":"logon-failed"},{"field":"src_type","op":"eq","value":"linux"},{"any":[{"field":"process","op":"in","value":["sshd","sshd-session"]},{"field":"fields.program","op":"in","value":["sshd","sshd-session"]},{"field":"fields.app","op":"in","value":["sshd","sshd-session"]},{"field":"fields.service","op":"eq","value":"ssh"}]}]},"group_by":["src_ip"],"window_s":300,"count":20,"suppress_s":3600,"fields_in_alert":["src_ip","host","user"]},
  {"id":"SENTRA-LNX-002","name":"Root logon over SSH","enabled":true,"severity":3,"mitre":["T1078.003","T1021.004"],"sama":["3.3.5"],"tactic":"privilege-escalation","author":"Sentra SOC","version":1,"description":"Successful SSH logon directly as root (PermitRootLogin should be disabled).","type":"single","match":{"all":[{"field":"action","op":"eq","value":"logon"},{"field":"outcome","op":"eq","value":"success"},{"field":"src_type","op":"eq","value":"linux"},{"field":"user","op":"eq","value":"root"},{"any":[{"field":"process","op":"in","value":["sshd","sshd-session"]},{"field":"fields.program","op":"in","value":["sshd","sshd-session"]},{"field":"fields.app","op":"in","value":["sshd","sshd-session"]},{"field":"fields.service","op":"eq","value":"ssh"}]}]},"group_by":["host","src_ip"],"suppress_s":3600,"fields_in_alert":["host","src_ip","user"]},
  {"id":"SENTRA-LNX-003","name":"sudo to an interactive root shell","enabled":true,"severity":3,"mitre":["T1548.003"],"sama":["3.3.5"],"tactic":"privilege-escalation","author":"Sentra SOC","version":1,"description":"sudo used to start a root shell (sudo -i / -s, sudo su, sudo bash …) instead of a specific command.","type":"single","match":{"all":[{"field":"action","op":"eq","value":"sudo"},{"field":"cmdline","op":"re","value":"^\\s*(\\S*/)?((ba|z|k|c|tc|da|fi|a)?sh|su)(?:\\s(?:-|-i|-l|-s|--login|root|-\\s?root))*\\s*$"}],"none":[{"field":"outcome","op":"eq","value":"failure"},{"all":[{"field":"target_user","op":"exists","value":true},{"field":"target_user","op":"neq","value":"root"}]}]},"group_by":["host","user"],"suppress_s":3600,"fields_in_alert":["host","user","target_user","cmdline"]},
  {"id":"SENTRA-LNX-004","name":"Repeated sudo authentication failures","enabled":true,"severity":2,"mitre":["T1548.003","T1110"],"sama":["3.3.5"],"tactic":"privilege-escalation","author":"Sentra SOC","version":1,"description":"3 or more failed sudo attempts by the same user on the same host within 5 minutes.","type":"threshold","match":{"all":[{"field":"action","op":"eq","value":"sudo"},{"field":"outcome","op":"eq","value":"failure"}]},"group_by":["host","user"],"window_s":300,"count":3,"suppress_s":3600,"fields_in_alert":["host","user","cmdline"]}
