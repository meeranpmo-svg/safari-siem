      "parser": "cisco", "default_port": 5514, "proto": "udp", "source_kind": "syslog",
      "snmp": 161, "sama": ["3.3.14", "3.3.8", "3.3.7"] },

    { "type": "cisco-asa-ftd", "kind": "cisco-asa-ftd", "vendor": "Cisco", "category": "firewall",
