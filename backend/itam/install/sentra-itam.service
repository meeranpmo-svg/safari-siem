# Sentra ITAM service - systemd unit (template: install.sh replaces @NODE_BIN@).
# Installed as /etc/systemd/system/sentra-itam.service. Local overrides: `systemctl edit sentra-itam`; install.sh
# rewrites this file on upgrade.
[Unit]
Description=Sentra AI IT Asset Management + CMDB (sentra-itam)
Documentation=file:///opt/sentra-itam/docs/ITAM.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# Dedicated unprivileged service account. ITAM reads the netops API over HTTP and vCenter over HTTPS; it needs no
# local privileged resource, so it does NOT run as root (unlike sentra-grcai, which must read the portal DB/key).
User=sentra-itam
Group=sentra-itam
WorkingDirectory=/opt/sentra-itam
Environment=NODE_ENV=production
Environment=SENTRA_ITAM_CONFIG=/etc/sentra-itam/config.json
Environment=SENTRA_ITAM_SECRETS=/etc/sentra-itam/secrets.json
EnvironmentFile=-/etc/default/sentra-itam
ExecStart=@NODE_BIN@ /opt/sentra-itam/engine/main.js
Restart=always
RestartSec=5
TimeoutStopSec=20
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sentra-itam

# ---- hardening ---------------------------------------------------------------------------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/sentra-itam
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=400M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
